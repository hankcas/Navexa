ENVIRONMENT=development
WIALON_BASE_URL=https://hst-api.wialon.com/wialon/ajax.html
WIALON_TOKEN=your_wialon_token_here
# Optional: Wialon resource where new drivers and passengers are created.
# Leave it commented out to use the first resource the token can see.
# WIALON_RESOURCE_ID=27668776

STATUS_MOVING_SPEED_KMH=5
STATUS_OFFLINE_MINUTES=60

DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_to_a_strong_password
FIRST_ADMIN_NAME=Administrador

JWT_SECRET=generate_with_python_secrets_token_urlsafe_64
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Login attempts allowed per IP in the window (seconds), on top of the per-account lock.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Origins allowed to call the API from another site (JSON list). The frontend goes through the
# Vercel proxy (same origin), so it stays empty. Example: ["https://navexa-three.vercel.app"]
CORS_ORIGINS=[]
# Swagger UI at /docs. Set to false to hide it.
DOCS_ENABLED=true